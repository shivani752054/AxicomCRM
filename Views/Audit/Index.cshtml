@model List<AuditLog>
<h3>Audit Log</h3><form method="get" class="mb-2"><select name="action" class="form-select w-auto d-inline"><option value="">All</option><option>Login</option><option>FailedLogin</option><option>Lockout</option><option>Create</option><option>Update</option><option>Delete</option><option>Register</option></select> <button class="btn btn-secondary">Filter</button></form>
<table class="table table-sm"><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>IP</th></tr>
@foreach (var a in Model) { <tr><td>@a.CreatedDate</td><td>@a.UserId</td><td>@a.Action</td><td>@a.EntityName</td><td>@a.RecordId</td><td>@a.IpAddress</td></tr> }</table>
