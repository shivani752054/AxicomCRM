<!DOCTYPE html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>AcxiomCRM</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/></head><body>
<nav class="navbar navbar-expand navbar-dark bg-dark px-3"><a class="navbar-brand" asp-controller="Home" asp-action="Index">AcxiomCRM</a>
@if (User.Identity!.IsAuthenticated) {
 <ul class="navbar-nav me-auto">
  <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a></li>
  @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Audit Log</a></li> }
 </ul>
 <form asp-controller="Account" asp-action="Logout" method="post"><span class="text-light me-2">@User.Identity.Name</span><button class="btn btn-sm btn-outline-light">Logout</button></form> }
</nav><div class="container mt-4">
@if (TempData["ok"] != null) { <div class="alert alert-success">@TempData["ok"]</div> }
@RenderBody()</div>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
@await RenderSectionAsync("Scripts", false)</body></html>
