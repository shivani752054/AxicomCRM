@model Opportunity
<h3>New Opportunity</h3><form asp-action="Create" method="post" style="max-width:500px"><div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-2"><label>Name</label><input asp-for="OpportunityName" class="form-control"/></div>
<div class="mb-2"><label>Customer</label><select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"></select></div>
<div class="mb-2"><label>Stage</label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div>
<div class="mb-2"><label>Amount</label><input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control"/></div>
<div class="mb-2"><label>Probability (0-100)</label><input asp-for="Probability" type="number" min="0" max="100" class="form-control"/></div>
<div class="mb-2"><label>Expected Close Date</label><input asp-for="ExpectedCloseDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control"/></div>
<button class="btn btn-primary">Save</button></form>
